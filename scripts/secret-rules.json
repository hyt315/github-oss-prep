{
  "version": "1.2.0",
  "note": "Single source of truth for secret/path scanning. Used by scripts/validate_repo.py and scripts/selftest.py. Do not duplicate these patterns anywhere else; docs must reference this file instead of re-listing regexes.",
  "severity_legend": {
    "P0": "fails the scan (blocks release)",
    "P1": "fails only with --strict, and only for the current tree; P1 hits in git history are reported but never block (they can only be removed by rewriting history)",
    "P2": "informational only (process hygiene)"
  },
  "credential_patterns": [
    {
      "id": "github-classic-pat",
      "label": "GitHub classic PAT",
      "severity": "P0",
      "regex": "gh[pousr]_[A-Za-z0-9]{36,255}"
    },
    {
      "id": "github-fine-grained-pat",
      "label": "GitHub fine-grained PAT",
      "severity": "P0",
      "regex": "github_pat_[A-Za-z0-9_]{30,255}"
    },
    {
      "id": "openai-style-key",
      "label": "OpenAI-style API key (incl. sk-proj-/sk-ant-)",
      "severity": "P0",
      "regex": "(?<![A-Za-z0-9_-])sk-(?:proj-|ant-)?[A-Za-z0-9_-]{20,}"
    },
    {
      "id": "stripe-secret-key",
      "label": "Stripe secret key",
      "severity": "P0",
      "regex": "sk_live_[A-Za-z0-9]{24,}"
    },
    {
      "id": "aws-access-key-id",
      "label": "AWS access key ID",
      "severity": "P0",
      "regex": "(?:AKIA|ASIA)[0-9A-Z]{16}"
    },
    {
      "id": "google-api-key",
      "label": "Google API key",
      "severity": "P0",
      "regex": "AIza[0-9A-Za-z_-]{35}"
    },
    {
      "id": "huggingface-token",
      "label": "Hugging Face token",
      "severity": "P0",
      "regex": "hf_[A-Za-z0-9]{30,}"
    },
    {
      "id": "npm-token",
      "label": "npm access token",
      "severity": "P0",
      "regex": "npm_[A-Za-z0-9]{36,}"
    },
    {
      "id": "pypi-token",
      "label": "PyPI API token",
      "severity": "P0",
      "regex": "pypi-AgEIcHlwaS5vcmc[A-Za-z0-9_-]{40,}"
    },
    {
      "id": "slack-token",
      "label": "Slack token",
      "severity": "P0",
      "regex": "xox[baprs]-[A-Za-z0-9-]{10,}"
    },
    {
      "id": "sendgrid-key",
      "label": "SendGrid API key",
      "severity": "P0",
      "regex": "SG\\.[A-Za-z0-9_-]{16,}\\.[A-Za-z0-9_-]{16,}"
    },
    {
      "id": "telegram-bot-token",
      "label": "Telegram bot token",
      "severity": "P0",
      "regex": "\\b[0-9]{8,10}:AA[A-Za-z0-9_-]{30,}"
    },
    {
      "id": "jwt",
      "label": "JSON Web Token",
      "severity": "P0",
      "regex": "eyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}"
    },
    {
      "id": "private-key-block",
      "label": "PEM private key block (incl. PKCS#8 without algorithm prefix)",
      "severity": "P0",
      "regex": "-----BEGIN (?:[A-Z0-9]+ )?PRIVATE KEY-----"
    },
    {
      "id": "azure-storage-account-key",
      "label": "Azure Storage account key",
      "severity": "P0",
      "regex": "AccountKey=[A-Za-z0-9+/=]{40,}"
    },
    {
      "id": "credential-in-url",
      "label": "Credentials embedded in URL (user:pass@ or a bare token@)",
      "severity": "P0",
      "regex": "https?://(?:[^/\\s:@<>{}$]{1,64}:[^/\\s:@<>{}$]{1,128}|[A-Za-z0-9_-]{30,})@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}"
    }
  ],
  "path_patterns": [
    {
      "id": "windows-user-profile-path",
      "label": "Windows user profile path with a real-looking user name (placeholders such as <user>, YourName, %USERNAME%, Public are ignored)",
      "severity": "P1",
      "regex": "[A-Za-z]:[\\\\/]{1,2}Users[\\\\/]{1,2}(?![<%$\\[{]|(?:YourName|yourname|YOURNAME|UserName|username|USERNAME|user|User|USER|Public|Default|All Users|xxx|XXX|用户名|你的用户名|张三)(?![^\\s\\\\/\\\"'`]))[^\\s\\\\/\\\"'`]+"
    },
    {
      "id": "windows-absolute-path",
      "label": "Absolute path on a local drive (informational: may reveal the author's folder layout; system folders are ignored)",
      "severity": "P2",
      "regex": "(?:^|[\\s(\\\"'`])[A-Za-z]:[\\\\/](?!(?:Windows|WINDOWS|ProgramData|Program Files|Users)(?:[\\\\/\\s\\\"'`]|$))(?:[^\\s\\\\/:*?\\\"<>|]+[\\\\/]){1,8}"
    },
    {
      "id": "unix-home-path",
      "label": "Unix home/root path with a real user name",
      "severity": "P1",
      "regex": "/(?:home|Users|root)/(?!(?:user|username|you|yourname|me|name|runner|ubuntu|example|USER|USERNAME)/)[A-Za-z0-9_.-]+/"
    },
    {
      "id": "wsl-or-mount-path",
      "label": "WSL / mounted drive path",
      "severity": "P1",
      "regex": "(?:\\\\\\\\wsl\\$|/mnt/[a-z])/"
    }
  ],
  "private_ip_patterns": [
    {
      "id": "rfc1918-ip",
      "label": "Private network IP",
      "severity": "P1",
      "regex": "\\b10\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\b|\\b192\\.168\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\b|\\b172\\.(?:1[6-9]|2[0-9]|3[01])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\b"
    }
  ],
  "local_env_patterns": [
    {
      "id": "local-proxy-config",
      "label": "Local proxy setting (reveals the author's network setup; use a <proxy> placeholder)",
      "severity": "P1",
      "regex": "(?i)(?:http\\.proxy|https?_proxy|all_proxy|--proxy)\\s*[=: ]\\s*['\"]?(?:https?|socks5h?)://(?:127\\.0\\.0\\.1|localhost|\\[::1\\]):\\d{2,5}"
    },
    {
      "id": "loopback-proxy-port",
      "label": "Loopback address on a well-known proxy-client port (Clash / V2Ray / Shadowsocks)",
      "severity": "P1",
      "regex": "(?:127\\.0\\.0\\.1|localhost):(?:7890|7891|7897|7898|1080|1081|10808|10809|20171|20172)\\b"
    },
    {
      "id": "machine-specific-claim",
      "label": "Statement about the author's own machine (本机实测/本机事实…); rewrite as a generic, conditional example",
      "severity": "P1",
      "regex": "本机(?:实测|事实|环境快照|复核|定稿|同时装有)"
    }
  ],
  "personal_patterns": [
    {
      "id": "personal-email",
      "label": "Personal mailbox address (qq/163/gmail/outlook…); use a noreply or example.com address",
      "severity": "P1",
      "regex": "(?<![A-Za-z0-9._%+-])[A-Za-z0-9._%+-]+@(?:qq|vip\\.qq|163|126|yeah|foxmail|sina|sohu|aliyun|139|gmail|googlemail|outlook|hotmail|live|msn|icloud|me|yahoo|proton|protonmail)\\.(?:com\\.cn|com|cn|net|me)(?![A-Za-z0-9.-])"
    },
    {
      "id": "cn-mobile-number",
      "label": "Mainland China mobile number",
      "severity": "P1",
      "regex": "(?<![0-9A-Za-z_.+-])(?:\\+?86[- ]?)?1[3-9][0-9]{9}(?![0-9A-Za-z_])"
    }
  ],
  "blocked_filenames": [
    {
      "glob": "**/.env",
      "severity": "P0",
      "reason": "environment file (allow .env.example / .env.sample)"
    },
    {
      "glob": "**/*.pem",
      "severity": "P0",
      "reason": "PEM material"
    },
    {
      "glob": "**/*.key",
      "severity": "P0",
      "reason": "key material"
    },
    {
      "glob": "**/*.p12",
      "severity": "P0",
      "reason": "certificate bundle"
    },
    {
      "glob": "**/*.pfx",
      "severity": "P0",
      "reason": "certificate bundle"
    },
    {
      "glob": "**/id_rsa",
      "severity": "P0",
      "reason": "SSH private key"
    },
    {
      "glob": "**/id_ed25519",
      "severity": "P0",
      "reason": "SSH private key"
    },
    {
      "glob": "**/.env.*",
      "severity": "P0",
      "reason": "environment file variant (.env.local, .env.production …)"
    },
    {
      "glob": "**/credentials.json",
      "severity": "P0",
      "reason": "service-account / OAuth credentials file"
    },
    {
      "glob": "**/id_ecdsa",
      "severity": "P0",
      "reason": "SSH private key"
    },
    {
      "glob": "**/id_dsa",
      "severity": "P0",
      "reason": "SSH private key"
    }
  ],
  "filename_allowlist": [
    ".env.example",
    ".env.sample",
    ".env.template"
  ],
  "suppression": {
    "comment_syntax": "<!-- scan-ignore: <rule-id> (<short reason>) -->",
    "scope": "line",
    "note": "A line carrying this comment is skipped for the named rule only. Every suppression is itself reported as a P2 finding so exemptions are visible in review."
  },
  "scan_scope": {
    "skip_dirs": [
      ".git",
      "node_modules",
      ".venv",
      "venv",
      "__pycache__",
      ".pytest_cache",
      "dist",
      "build",
      ".mypy_cache",
      ".ruff_cache"
    ],
    "skip_extensions": [
      ".png",
      ".jpg",
      ".jpeg",
      ".gif",
      ".webp",
      ".ico",
      ".svg",
      ".pdf",
      ".zip",
      ".gz",
      ".tar",
      ".whl",
      ".exe",
      ".dll",
      ".so",
      ".dylib",
      ".mp4",
      ".mp3",
      ".woff",
      ".woff2",
      ".ttf",
      ".otf",
      ".lock",
      ".gguf",
      ".safetensors",
      ".bin",
      ".onnx",
      ".pt",
      ".pth",
      ".ckpt",
      ".parquet",
      ".npy",
      ".npz",
      ".h5",
      ".7z",
      ".rar",
      ".iso",
      ".msi"
    ],
    "skip_paths": [
      "scripts/secret-rules.json",
      "tests/fixtures"
    ],
    "max_file_bytes": 5242880
  }
}
